{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.84",
        "--browser",
        "msedge",
        "--ignore-https-errors",
        "--isolated",
        "--headless",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
