# Example of env variables
# make sure to `cp .env.example .env` and replace the values
# https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/#env-file
#-------------------------------------------------------------------------------
# the db service of docker compose, 5433 so a system postgres on 5432 is never used by mistake
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
POSTGRES_DB=roommates
POSTGRES_USER=REPLACE_WITH_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD
TEST_POSTGRES_DB=rm_test_db
#-------------------------------------------------------------------------------
SERVER_PORT=8080
# base of links in emails, defaults to https://localhost:SERVER_PORT in development
#APP_BASE_URL=https://example.com
SESSION_HASH_KEY=`openssl rand -hex 32`
SESSION_BLOCK_KEY=`openssl rand -hex 16`
# SESSION_HASH_KEY_PREVIOUS=used to rotate this out with SESSION_HASH_KEY
# SESSION_BLOCK_KEY_PREVIOUS=used to rotate this out with SESSION_BLOCK_KEY
#-------------------------------------------------------------------------------
# without SMTP_HOST, development writes emails to the log
# mailpit from docker compose (inbox at http://127.0.0.1:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Roommates <noreply@localhost>
# a real provider (STARTTLS on 587, e.g. Resend: smtp.resend.com, user resend, password = API key)
#SMTP_USERNAME=
#SMTP_PASSWORD=