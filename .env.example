# Example of env variables
# make sure to `cp .env.example .env` and replace the values
# https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/#env-file
# An empty value (KEY=) counts as unset. The app container only gets the keys listed
# under app.environment in docker-compose.yml
#-------------------------------------------------------------------------------
# docker compose profiles: dev (mailpit) on your machine, prod (cloudflared tunnel) on the server
COMPOSE_PROFILES=dev
# a second copy running on the same machine needs its own project name (the folder name
# by default) and its own host ports: DATABASE_PORT and the *_PORT settings below
#COMPOSE_PROJECT_NAME=roommates
#-------------------------------------------------------------------------------
# the db service of docker compose, 5433 so a system postgres on 5432 is never used by mistake;
# DATABASE_PORT is also the host port docker compose publishes it on
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
POSTGRES_DB=roommates
POSTGRES_USER=REPLACE_WITH_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD
TEST_POSTGRES_DB=rm_test_db
# connection pool size, default 10
#DATABASE_MAX_CONNS=10
#-------------------------------------------------------------------------------
# host port of the app container, https://127.0.0.1:8000
# (inside the container the server listens on 8080, `task dev` serves on 8090)
#APP_PORT=8000
# base of links in emails; defaults to https://localhost:8090 under `task dev` and to
# https://127.0.0.1:APP_PORT in docker compose. With TRUSTED_PLATFORM set the app refuses
# to start unless it is a public https address
#APP_BASE_URL=https://roommates.example.com
# set when TLS ends at Cloudflare (Tunnel) or Fly.io: cloudflare or flyio,
# the server then speaks plain HTTP, never publish its port publicly
#TRUSTED_PLATFORM=cloudflare
# the cloudflared service (prod profile), see deploy/README.md; its target is http://app:8080
#CLOUDFLARE_TUNNEL_TOKEN=
SESSION_HASH_KEY=`openssl rand -hex 32`
SESSION_BLOCK_KEY=`openssl rand -hex 16`
# SESSION_HASH_KEY_PREVIOUS=used to rotate this out with SESSION_HASH_KEY
# SESSION_BLOCK_KEY_PREVIOUS=used to rotate this out with SESSION_BLOCK_KEY
#-------------------------------------------------------------------------------
# files, the rustfs service of docker compose (the bucket is created on start)
# host ports of its S3 API and console; S3_ENDPOINT's port must match RUSTFS_PORT
#RUSTFS_PORT=9000
#RUSTFS_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=roommates
# https://docs.rustfs.com/en/operations/credentials#root-credentials
S3_ACCESS_KEY=`openssl rand -hex 20 | tr 'a-f' 'A-F'`
S3_SECRET_KEY=`openssl rand -hex 32 | tr 'a-f' 'A-F'`
#S3_REGION=us-east-1
# the app's own key (S3_BUCKET only), REQUIRED; the root keys above are for rustfs and
# backup only. Create both with: docker compose up -d --wait rustfs && sh deploy/rustfs/app-key.sh
# (see deploy/README.md 7.6)
APP_S3_ACCESS_KEY=
APP_S3_SECRET_KEY=
# RustFS console on http://127.0.0.1:RUSTFS_CONSOLE_PORT, off by default, `task dev` turns it on
#RUSTFS_CONSOLE_ENABLE=true
#-------------------------------------------------------------------------------
# the backup service of docker compose, see deploy/backup/README.md
# host folder for the backups, point it at another drive to survive a dead disk
#BACKUP_DIR=./backups
# days of dumps and deleted files to keep
#BACKUP_KEEP_DAYS=14
# mailed (through SMTP_*) when a run fails or the last good one is over 2 days old,
# unset = log only; test with: docker compose run --rm backup test-alert
#BACKUP_ALERT_EMAIL=
#-------------------------------------------------------------------------------
# host ports of the compose mailpit (development): SMTP, and the inbox http://127.0.0.1:8025
#MAILPIT_SMTP_PORT=1025
#MAILPIT_WEB_PORT=8025
# unset in development: `task dev` and the containers both reach the compose mailpit
# (inbox at http://127.0.0.1:8025); set them for a real provider in production, with
# TRUSTED_PLATFORM set the app refuses mailpit. A non-local host must offer STARTTLS,
# otherwise sending fails
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_FROM=Roommates <noreply@your-domain>
# a real provider (STARTTLS on 587, e.g. Resend: smtp.resend.com, user resend, password = API key)
#SMTP_USERNAME=
#SMTP_PASSWORD=
#-------------------------------------------------------------------------------
# web push, REQUIRED in production (the app refuses to start without both keys);
# without VAPID_PRIVATE_KEY development writes notifications to the log
# generate once and keep them: new keys break every phone that turned notifications on
# generate the pair with: go run ./tools/vapid-keys (from app/)
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# an email address or https URL push services can reach you at, defaults to APP_BASE_URL
#VAPID_SUBJECT=
