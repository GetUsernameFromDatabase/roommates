# Example of env variables
# make sure to `cp .env.example .env` and replace the values
# https://docs.docker.com/compose/how-tos/environment-variables/variable-interpolation/#env-file
#-------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_DB=roommates
POSTGRES_USER=REPLACE_WITH_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD
TEST_POSTGRES_DB=rm_test_db
#-------------------------------------------------------------------------------
SERVER_PORT=8080
# only used for sending emails with resend
#RESEND_API_KEY=https://resend.com/api-keys

SESSION_HASH_KEY=`openssl rand -hex 32`
SESSION_BLOCK_KEY=`openssl rand -hex 16`
# SESSION_HASH_KEY_PREVIOUS=used to rotate this out with SESSION_HASH_KEY
# SESSION_BLOCK_KEY_PREVIOUS=used to rotate this out with SESSION_BLOCK_KEY
#-------------------------------------------------------------------------------
