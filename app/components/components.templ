package components

import "roommates/locales"
import "roommates/utils"

// wraps component with html tag
//
//  <!DOCTYPE html>
//  <html>children...</html>
templ HtmlWrap() {
	// TODO: https://templ.guide/syntax-and-usage/template-composition#children
	<!DOCTYPE html>
	<html lang={ utils.GetLocaleString(ctx) }>
		{ children... }
	</html>
}

// title has default which is i18n-zed
templ HeaderComponent(title string) {
	{{
		if title == "" {
			title = utils.T(ctx, locales.LK_AppTitle)
		}
	}}
	<head>
		<title>{ title }</title>
		<link rel="stylesheet" href="/assets/output.css"/>
		// https://htmx.org/docs/#installing
		<script src="/assets/htmx.org@2.0.11.min.js"></script>
		// this reccomends to use @components.Scripts()
		// https://shadcn-templ.com/docs/installation#javascript
		// but scripts_bundle.go just has bundleSrc
		<script src={ bundleSrc }></script>
	</head>
}

templ ValidationErrors(messages []locales.LKMessage) {
	if len(messages) > 0 {
		<div class="text-sm font-medium text-destructive " aria-live="polite">
			for _, msg := range messages {
				<li class="error">@T(msg.Key, msg.Args...)</li>
			}
		</div>
	}
}
