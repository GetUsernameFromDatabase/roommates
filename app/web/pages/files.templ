package pages

import "roommates/web/components"
import "roommates/web/components/button"
import "roommates/web/components/input"
import "roommates/web/components/popover"
import "roommates/web/components/select"
import "roommates/web/components/textarea"
import "roommates/internal/db/dbqueries"
import "roommates/internal/services"
import "roommates/internal/events"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"
import "github.com/invopop/ctxi18n/i18n"
import "github.com/jackc/pgx/v5/pgtype"
import "cmp"
import "context"
import "net/url"
import "unicode/utf8"

// names of the [services.FileKinds] and [services.FilePlaces] options
var (
	fileKindNames = map[string]locales.LK{
		"image": locales.LK_FilesTypeImage,
		"pdf":   locales.LK_FilesTypePdf,
		"other": locales.LK_FilesTypeOther,
	}
	filePlaceNames = map[string]locales.LK{
		"note":    locales.LK_FilesPlaceNote,
		"item":    locales.LK_FilesPlaceItem,
		"expense": locales.LK_FilesPlaceExpense,
		"message": locales.LK_FilesPlaceMessage,
		"none":    locales.LK_FilesPlaceNone,
	}
)

// HouseholdFiles lists the files the actor may see that match filter, newest first,
// errorMessage is the outcome of an upload
templ HouseholdFiles(actor services.Membership, files []dbqueries.ListFilesRow, filter services.FileFilter, errorMessage string) {
	@appShell(utils.T(ctx, locales.LK_NavFiles), &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionFiles}) {
		<header>
			<h1 class="doorplate">
				@components.T(locales.LK_NavFiles)
			</h1>
		</header>
		<section class={ utils.CN(sheetClass, "space-y-4") }>
			@formError(errorMessage)
			@fileUploadForm(householdURL(actor.HouseholdID, "files"))
			@fileFilters(actor, filter)
			@liveRegion("files", events.TopicFiles) {
				if len(files) == 0 {
					<p class="text-muted-foreground">
						@components.T(utils.IfElse(filter.Active(), locales.LK_FilesNoMatch, locales.LK_FilesNone))
					</p>
				} else {
					<ul class="divide-y">
						for _, f := range files {
							@fileRow(actor, householdURL(actor.HouseholdID, "files"), "", false, false, f.RefCount, f.ID, f.Name, f.HasThumb, f.SizeBytes, f.UploaderID, f.UploaderName, f.CreatedAt) {
								if f.NoteTitle != nil {
									<a href={ householdURL(actor.HouseholdID, "notes", f.NoteID.String()) } class={ fileContextClass }>
										{ utils.T(ctx, locales.LK_FilesOnNote, *f.NoteTitle) }
									</a>
								} else if f.ItemText != nil {
									<a href={ householdURL(actor.HouseholdID, "lists", f.ItemListID.String(), "items", f.ShoppingItemID.String()) } class={ fileContextClass }>
										{ utils.T(ctx, locales.LK_FilesOnItem, *f.ItemText) }
									</a>
								} else if f.ExpenseTitle != nil {
									<a href={ householdURL(actor.HouseholdID, "expenses", f.ExpenseID.String()) } class={ fileContextClass }>
										{ utils.T(ctx, locales.LK_FilesOnExpense, *f.ExpenseTitle) }
									</a>
								} else if f.MessageID.Valid {
									<a href={ householdURL(actor.HouseholdID, "chat") } class={ fileContextClass }>
										@components.T(locales.LK_FilesOnMessage)
									</a>
								}
							}
						}
					</ul>
				}
			}
		</section>
	}
}

// deleteConfirm adds to question how many files would go with the deletion
func deleteConfirm(ctx context.Context, question string, files int) string {
	if files == 0 {
		return question
	}
	return question + "\n" + utils.N(ctx, locales.LK_FilesDeletedWith, files, i18n.M{"count": files})
}

// deleteKeepConfirm is [deleteConfirm] for a form with data-confirm-keep, the dialog itself saves the files
func deleteKeepConfirm(ctx context.Context, question string, files int) string {
	if files == 0 {
		return question
	}
	return question + "\n" + utils.N(ctx, locales.LK_FilesDeletedWithKeep, files, i18n.M{"count": files})
}

// deleteFileConfirm says where else a file on refs places goes from, the Files list shows only its first
func deleteFileConfirm(ctx context.Context, name string, refs int64) string {
	question := utils.T(ctx, locales.LK_CommonDelete) + " " + name + "?"
	if refs < 2 {
		return question
	}
	return question + "\n" + utils.T(ctx, locales.LK_FilesDeleteShared, refs)
}

// lastRefs counts the files that go with what they are attached to
func lastRefs(files []services.AttachedFile) int {
	n := 0
	for _, f := range files {
		if f.LastRef {
			n++
		}
	}
	return n
}

const fileContextClass ="block text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"

// fileFilters swaps in the matching files while typing and keeps the filter in the address,
// the live region then refetches the same filter; it stays out of the region, a refetch would clear what is typed
templ fileFilters(actor services.Membership, filter services.FileFilter) {
	{{ filesURL := householdURL(actor.HouseholdID, "files") }}
	<form
		role="search"
		action={ filesURL }
		method="get"
		hx-get={ string(filesURL) }
		hx-trigger="input delay:300ms, change from:input[name=type], change from:input[name=place]"
		hx-target="#files"
		hx-select="#files"
		hx-swap="outerHTML"
		hx-replace-url="true"
		class="flex flex-wrap gap-2"
	>
		@input.Input(input.Props{
			Name:        "q",
			Type:        "search",
			Value:       filter.Query,
			Placeholder: utils.T(ctx, locales.LK_FilesSearch),
			Class:       "h-11 min-w-48 flex-1",
			Attributes:  templ.Attributes{"aria-label": utils.T(ctx, locales.LK_FilesSearch)},
		})
		@fileFilterSelect("file-type", "type", filter.Kind, locales.LK_FilesType, locales.LK_FilesAnyType, services.FileKinds, fileKindNames)
		@fileFilterSelect("file-place", "place", filter.Place, locales.LK_FilesPlace, locales.LK_FilesAnyPlace, services.FilePlaces, filePlaceNames)
	</form>
}

// fileFilterSelect submits name, "all" narrows nothing down
templ fileFilterSelect(id, name, value string, label, all locales.LK, options []string, names map[string]locales.LK) {
	{{
	items := []selectcomp.ItemData{{Value: "all", Label: utils.T(ctx, all)}}
	for _, o := range options {
		items = append(items, selectcomp.ItemData{Value: o, Label: utils.T(ctx, names[o])})
	}
	}}
	@optionSelect(id, name, cmp.Or(value, "all"), "data-[size=default]:h-11", templ.Attributes{"aria-label": utils.T(ctx, label)}, items)
}

// attachedFiles are the files of a note, shopping item or expense on page back, with a form to add
// one and a picker of existing ones, hint says what belongs here if anything
templ attachedFiles(actor services.Membership, back templ.SafeURL, files []services.AttachedFile, hint locales.LK, errorMessage string) {
	<section class={ utils.CN(sheetClass, "space-y-3") } aria-labelledby="attachments-title">
		@attachedFilesContent(actor, back, files, hint, errorMessage, false)
	</section>
}

// attachedFilesTill is [attachedFiles] as a till slip, the receipts stapled to it
templ attachedFilesTill(actor services.Membership, back templ.SafeURL, files []services.AttachedFile, hint locales.LK, errorMessage string) {
	<section class="till-slip" aria-labelledby="attachments-title">
		<div class="till-paper space-y-3">
			@attachedFilesContent(actor, back, files, hint, errorMessage, true)
		</div>
	</section>
}

// attachedFilesContent goes on a sheet, or on till paper with till
templ attachedFilesContent(actor services.Membership, back templ.SafeURL, files []services.AttachedFile, hint locales.LK, errorMessage string, till bool) {
	<h2 id="attachments-title" class="text-xl font-semibold">
		@components.T(locales.LK_FilesAttachments)
	</h2>
	if hint != "" {
		<p class="text-sm text-muted-foreground">
			@components.T(hint)
		</p>
	}
	@liveRegion("attachments", events.TopicFiles) {
		if len(files) > 0 {
			<ul class={ "divide-y", templ.KV("divide-dashed", till) }>
				for _, f := range files {
					@fileRow(actor, back, back+"/files/detach", f.LastRef, f.Shared, 0, f.ID, f.Name, f.HasThumb, f.SizeBytes, f.UploaderID, f.UploaderName, f.CreatedAt)
				}
			</ul>
		}
	}
	@formError(errorMessage)
	<div class={ "flex flex-wrap items-start gap-2", templ.KV("till-perforation", till) }>
		@fileUploadForm(back + "/files")
		@attachFilePicker(back)
	</div>
}

// attachFilePicker lets the page at back show a file that already exists, the list is fetched
// the first time it opens, after that it follows the search box
templ attachFilePicker(back templ.SafeURL) {
	{{
	picks := templ.Attributes{
		"hx-get":    string(back + "/files/picks"),
		"hx-target": "#attach-file-picks",
		"hx-select": "#attach-file-picks",
		"hx-swap":   "outerHTML",
	}
	}}
	@popover.Popover(popover.Props{ID: "attach-file-popover"}) {
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeLg,
			Class:      "h-11",
			Attributes: utils.MergeAttributes(popover.Trigger(ctx), picks, templ.Attributes{"hx-trigger": "click once"}),
		}) {
			@components.T(locales.LK_ChatReference)
		}
		// portaled to the body, the till paper's mask would cut it off
		@popover.Content(popover.ContentProps{Class: "w-80 max-w-[calc(100vw-1rem)] gap-2 p-2", Side: popover.SideBottom, Align: popover.AlignStart}) {
			@input.Input(input.Props{
				Name:        "q",
				Type:        "search",
				Placeholder: utils.T(ctx, locales.LK_ChatReferenceSearch),
				Class:       "h-11",
				Attributes: utils.MergeAttributes(picks, templ.Attributes{
					"hx-trigger": "input delay:200ms",
					"aria-label": utils.T(ctx, locales.LK_ChatReferenceSearch),
				}),
			})
			<div id="attach-file-picks"></div>
		}
	}
}

// AttachFilePicks is the list of [attachFilePicker], the page reloads after a pick like after an upload
templ AttachFilePicks(actor services.Membership, back templ.SafeURL, files []dbqueries.ListFilesRow) {
	<form id="attach-file-picks" action={ back + "/files/attach" } method="post" class="max-h-60 overflow-y-auto">
		if len(files) == 0 {
			<p class="p-2 text-sm text-muted-foreground">
				@components.T(locales.LK_ChatReferenceNone)
			</p>
		}
		<ul>
			for _, f := range files {
				<li>
					<button type="submit" name="file_id" value={ f.ID.String() } class={ filePickClass }>
						@filePickContent(actor, f)
					</button>
				</li>
			}
		</ul>
	</form>
}

const filePickClass = "flex min-h-11 w-full items-center gap-2 rounded-lg px-2 text-left text-sm outline-none hover:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50"

// filePickContent is a row of a list of existing files to pick from
templ filePickContent(actor services.Membership, f dbqueries.ListFilesRow) {
	if f.HasThumb {
		<img src={ string(householdURL(actor.HouseholdID, "files", f.ID.String())) + "/thumb" } alt="" loading="lazy" class="size-8 shrink-0 rounded object-cover"/>
	}
	<span class="min-w-0 flex-1 truncate">{ f.Name }</span>
	<span class="shrink-0 text-xs text-muted-foreground">{ formatSize(f.SizeBytes) }</span>
}

// fileUploadForm is a plain form, not boosted, the page reloads after an upload;
// file-upload.js submits it when a file is picked
templ fileUploadForm(action templ.SafeURL) {
	<form action={ action } method="post" enctype="multipart/form-data">
		<label class={ utils.CN(button.Variants(button.Props{Size: button.SizeLg}), "h-11 cursor-pointer has-focus-visible:ring-3 has-focus-visible:ring-ring/50 inert:opacity-50") }>
			<input type="file" name="file" required data-upload-on-pick class="sr-only"/>
			@components.T(locales.LK_FilesUpload)
		</label>
	</form>
}

// fileRow links the file, an image with its thumbnail, children say where it is attached;
// a delete goes back to page back, a file with a detach address is attached and is taken off
// there instead, lastRef warns that this deletes it and if shared the dialog offers to keep it,
// keeping a file of a private note would show it to everyone, refs is how many places a delete
// takes it from
templ fileRow(actor services.Membership, back, detach templ.SafeURL, lastRef, shared bool, refs int64, id pgtype.UUID, name string, hasThumb bool, size int64,
	uploaderID pgtype.UUID, uploaderName string, createdAt pgtype.Timestamptz) {
	{{ href := householdURL(actor.HouseholdID, "files", id.String()) }}
	<li class={ "flex min-h-14 gap-3 py-2", utils.IfElse(detach != "", "items-start", "items-center") }>
		if hasThumb {
			<a href={ href } class="file-thumb shrink-0" tabindex="-1" aria-hidden="true">
				<img src={ string(href) + "/thumb" } alt="" loading="lazy" class="size-12 rounded-lg object-cover ring-1 ring-foreground/10"/>
			</a>
		}
		<div class="min-w-0 flex-1">
			<a href={ href } class="line-clamp-2 font-medium break-words hover:underline">{ name }</a>
			<div class="text-xs text-muted-foreground">
				{ utils.T(ctx, locales.LK_FilesAddedBy, uploaderName, formatDate(createdAt), formatSize(size)) }
			</div>
			{ children... }
			if detach != "" {
				<form
					action={ detach }
					method="post"
					hx-boost="true"
					class="-ml-3"
					if lastRef {
						hx-confirm={ utils.T(ctx, locales.LK_FilesDetachLast, name) }
						data-confirm-label={ utils.T(ctx, locales.LK_FilesDetach) }
						if shared {
							data-confirm-keep={ utils.T(ctx, locales.LK_FilesDetachKeep) }
						}
					}
				>
					<input type="hidden" name="file_id" value={ id.String() }/>
					<input type="hidden" name={ g.QueryNext } value={ string(back) }/>
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantGhost,
						Class:   utils.CN("h-11 px-3", utils.IfElse(lastRef, "text-destructive", "")),
					}) {
						@components.T(locales.LK_FilesDetach)
					}
				</form>
			}
		</div>
		if detach == "" && uploaderID == actor.UserID {
			<form action={ href + "/delete" } method="post" hx-boost="true" hx-confirm={ deleteFileConfirm(ctx, name, refs) }>
				<input type="hidden" name={ g.QueryNext } value={ string(back) }/>
				@button.Button(button.Props{
					Type:    button.TypeSubmit,
					Variant: button.VariantGhost,
					Class:   "h-11 px-3 text-destructive",
				}) {
					@components.T(locales.LK_CommonDelete)
				}
			</form>
		}
	</li>
}

// FilePage shows one file inside the app, an image as large as fits the screen, opening the raw
// file in a new tab, with a way back to where it is attached, errorMessage is the outcome of a rename;
// the raw file at /raw has no way back
templ FilePage(actor services.Membership, f services.FileMeta, errorMessage string) {
	{{ fileURL := householdURL(actor.HouseholdID, "files", f.ID.String()) }}
	{{ back, backText, section := householdURL(actor.HouseholdID, "files"), utils.T(ctx, locales.LK_FilesAll), SectionFiles }}
	if f.NoteTitle != nil {
		{{ back, backText, section = householdURL(actor.HouseholdID, "notes", f.NoteID.String()), utils.T(ctx, locales.LK_FilesOnNote, *f.NoteTitle), SectionNotes }}
	} else if f.ItemText != nil {
		{{ back = householdURL(actor.HouseholdID, "lists", f.ItemListID.String(), "items", f.ShoppingItemID.String()) }}
		{{ backText, section = utils.T(ctx, locales.LK_FilesOnItem, *f.ItemText), SectionShopping }}
	} else if f.ExpenseTitle != nil {
		{{ back = householdURL(actor.HouseholdID, "expenses", f.ExpenseID.String()) }}
		{{ backText, section = utils.T(ctx, locales.LK_FilesOnExpense, *f.ExpenseTitle), SectionExpenses }}
	} else if f.MessageID.Valid {
		{{ back, backText, section = householdURL(actor.HouseholdID, "chat"), utils.T(ctx, locales.LK_FilesOnMessage), SectionChat }}
	}
	@appShell(f.Name, &HouseholdNav{HouseholdID: actor.HouseholdID, Section: section}) {
		if f.UploaderID == actor.UserID {
			// the extension stays
			{{ stem, ext := services.SplitFileName(f.Name) }}
			@nameHeader(back, backText, fileURL+"/name", stem,
				services.MaxFileNameLength-utf8.RuneCountInString(ext), utils.T(ctx, locales.LK_FilesRename)) {
				<span class="shrink-0">{ ext }</span>
			}
		} else {
			@doorplateHeader(back, backText, f.Name)
		}
		<p class="-mt-6 text-xs text-muted-foreground">
			{ utils.T(ctx, locales.LK_FilesAddedBy, f.UploaderName, formatDate(f.CreatedAt), formatSize(f.SizeBytes)) }
		</p>
		@formError(errorMessage)
		if services.ImageMimes[f.Mime] {
			// the rem are what else is on the page, with the phone's header and nav
			<a href={ fileURL + "/raw" } target="_blank" rel="noopener" class="mx-auto block w-fit max-w-full cursor-zoom-in">
				<img src={ string(fileURL) + "/raw" } alt={ f.Name } class="max-h-[max(12rem,calc(100dvh-26rem))] max-w-full rounded-2xl object-contain ring-1 ring-foreground/10 lg:max-h-[max(12rem,calc(100dvh-20rem))]"/>
			</a>
		}
		<div class="flex flex-wrap gap-2">
			@button.Button(button.Props{
				// its own address, the image's cached response has the name from before a rename
				Href:       string(fileURL) + "/raw?name=" + url.QueryEscape(f.Name),
				Size:       button.SizeLg,
				Attributes: templ.Attributes{"download": f.Name},
			}) {
				@components.T(locales.LK_FilesDownload)
			}
			// only its last reference could take it away, and keeping must not show a private note's file to everyone
			if !f.Kept && f.RefCount == 1 && f.Shared {
				<form action={ fileURL + "/keep" } method="post" hx-boost="true">
					<input type="hidden" name={ g.QueryNext } value={ string(fileURL) }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeLg}) {
						@components.T(locales.LK_FilesKeep)
					}
				</form>
			}
			if f.UploaderID == actor.UserID {
				<form
					action={ fileURL + "/delete" }
					method="post"
					hx-boost="true"
					hx-confirm={ deleteFileConfirm(ctx, f.Name, f.RefCount) }
					class="ml-auto"
				>
					<input type="hidden" name={ g.QueryNext } value={ string(back) }/>
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantOutline,
						Size:    button.SizeLg,
						Class:   "text-destructive",
					}) {
						@components.T(locales.LK_CommonDelete)
					}
				</form>
			}
		</div>
	}
}

// ShoppingItemPage is one item of a list with its description and files, a photo of the right product say,
// and the expense it was bought under with the receipt, expense is nil until there is one
templ ShoppingItemPage(actor services.Membership, listID pgtype.UUID, it services.ShoppingItem, expense *services.Expense, files []services.AttachedFile, errorMessage string) {
	{{ itemURL := householdURL(actor.HouseholdID, "lists", listID.String(), "items", it.ID.String()) }}
	@appShell(it.Text, &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionShopping}) {
		@doorplateHeader(householdURL(actor.HouseholdID, "lists", listID.String()), utils.T(ctx, locales.LK_ShoppingItemBack), it.Text)
		if it.Qty != "" {
			<p class="-mt-6 text-muted-foreground">{ it.Qty }</p>
		}
		<form action={ itemURL + "/description" } method="post" class={ utils.CN(sheetClass, "space-y-3") }>
			<label for="item-description" class="block font-heading text-xl font-semibold tracking-tight">
				@components.T(locales.LK_ShoppingDescription)
			</label>
			@textarea.Textarea(textarea.Props{
				ID:          "item-description",
				Name:        "description",
				Value:       it.Description,
				Placeholder: utils.T(ctx, locales.LK_ShoppingDescriptionPlaceholder),
				Attributes: templ.Attributes{
					"maxlength": services.MaxShoppingItemDescriptionLength,
				},
			})
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
				@components.T(locales.LK_CommonSave)
			}
		</form>
		@attachedFiles(actor, itemURL, files, locales.LK_ShoppingItemFilesHint, errorMessage)
		if expense != nil {
			{{ expenseURL := householdURL(actor.HouseholdID, "expenses", expense.Expense.ID.String()) }}
			<section class={ utils.CN(sheetClass, "space-y-3") } aria-labelledby="item-expense-title">
				<h2 id="item-expense-title" class="text-xl font-semibold">
					@components.T(locales.LK_ShoppingItemExpense)
				</h2>
				<a href={ expenseURL } class="flex min-h-11 items-center justify-between gap-3 hover:underline">
					<span class="min-w-0 font-medium break-words">{ expense.Expense.Title }</span>
					<span class="shrink-0 font-semibold tabular-nums">{ utils.FormatMoney(ctx, expense.Expense.AmountCents, actor.Currency) }</span>
				</a>
				if len(expense.Files) > 0 {
					<ul class="divide-y border-t">
						for _, f := range expense.Files {
							@fileRow(actor, itemURL, expenseURL+"/files/detach", f.LastRef, f.Shared, 0, f.ID, f.Name, f.HasThumb, f.SizeBytes, f.UploaderID, f.UploaderName, f.CreatedAt)
						}
					</ul>
				}
			</section>
		}
		if it.CreatedBy == actor.UserID {
			<form
				action={ householdURL(actor.HouseholdID, "lists", listID.String(), "items", it.ID.String(), "delete") }
				method="post"
				hx-boost="true"
				hx-confirm={ deleteConfirm(ctx, utils.T(ctx, locales.LK_CommonDelete)+" "+it.Text+"?", lastRefs(files)) }
			>
				@button.Button(button.Props{
					Type:    button.TypeSubmit,
					Variant: button.VariantGhost,
					Class:   "-ml-3 text-destructive hover:text-destructive",
				}) {
					@components.T(locales.LK_CommonDelete)
				}
			</form>
		}
	}
}
