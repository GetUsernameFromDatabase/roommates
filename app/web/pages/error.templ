package pages

import "roommates/web/components/card"
import "roommates/internal/locales"
import "roommates/internal/utils"

// Error is a generic error page, details are only logged
templ Error() {
	@Notice(utils.T(ctx, locales.LK_ErrorPageTitle), utils.T(ctx, locales.LK_ErrorPageDescription),
		"/", utils.T(ctx, locales.LK_ErrorPageBack))
}

// NotFound is also shown for things the user has no access to, so their existence is not revealed
templ NotFound() {
	@Notice(utils.T(ctx, locales.LK_NotFoundPageTitle), utils.T(ctx, locales.LK_NotFoundPageDescription),
		"/", utils.T(ctx, locales.LK_ErrorPageBack))
}

// Notice is a page with only a message and a link
templ Notice(title, description string, href templ.SafeURL, linkText string) {
	@guestShell("") {
		<main class="flex min-h-svh items-center justify-center bg-background p-6 text-foreground sm:p-10">
			@card.Card(card.Props{
				Class: "w-full max-w-sm",
			}) {
				@card.Header() {
					@card.Title() {
						{ title }
					}
					@card.Description() {
						{ description }
					}
				}
				@card.Content() {
					<a href={ href } class="text-sm font-medium underline-offset-4 hover:underline">
						{ linkText }
					</a>
				}
			}
		</main>
	}
}

// Offline is shown by the service worker for any page that cannot load, the link reloads it
templ Offline() {
	@Notice(utils.T(ctx, locales.LK_OfflineTitle), utils.T(ctx, locales.LK_OfflineDescription),
		"", utils.T(ctx, locales.LK_OfflineRetry))
}
