package pages

import "roommates/web/components"
import "roommates/web/components/avatar"
import "roommates/web/components/button"
import "roommates/web/components/field"
import "roommates/web/components/input"
import "roommates/internal/services"
import "roommates/internal/events"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"
import "github.com/jackc/pgx/v5/pgtype"
import "github.com/invopop/ctxi18n/i18n"

// HouseholdShopping is the first section of a household, its shopping lists,
// errorMessage is the outcome of the last action
templ HouseholdShopping(actor services.Membership, o services.HouseholdOverview, errorMessage string) {
	@appShell(o.Household.Name, &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionShopping}) {
		<header>
			<h1 class="doorplate">
				@components.T(locales.LK_NavShopping)
			</h1>
		</header>
		@VerifyEmailBanner(o.ActorEmailValidated)
		<section aria-labelledby="lists-title">
			<h2 id="lists-title" class="sr-only">
				@components.T(locales.LK_ShoppingLists)
			</h2>
			@liveRegion("shopping-lists", events.TopicShopping) {
				// the bags by the door: green has something to buy, linen is empty
				<ul class="bag-rail">
					for _, l := range o.ShoppingLists {
						<li>
							<a href={ householdURL(actor.HouseholdID, "lists", l.ID.String()) } data-empty?={ l.OpenItems == 0 } class="tote">
								<span class="tote-name">{ l.Name }</span>
								<span class="text-sm">{ utils.T(ctx, locales.LK_ShoppingOpenItems, l.OpenItems) }</span>
							</a>
						</li>
					}
					<li>
						// the name field below has the words, the empty peg only points at it
						<label for="new-list" class="tote tote-slot" aria-hidden="true">+</label>
					</li>
				</ul>
				if len(o.ShoppingLists) == 0 {
					<p class="mt-2 text-muted-foreground">
						@components.T(locales.LK_ShoppingNoLists)
					</p>
				}
			}
			<form action={ householdURL(actor.HouseholdID, "lists") } method="post" hx-boost="true" class="mt-4 grid grid-cols-[minmax(0,1fr)_auto] gap-2 sm:grid-cols-[minmax(0,1fr)_11rem_auto]">
				@input.Input(input.Props{
					ID:          "new-list",
					Name:        "name",
					Type:        "text",
					Placeholder: utils.T(ctx, locales.LK_ShoppingNewList),
					Required:    true,
					Class:       "col-span-2 h-10 bg-card sm:col-span-1 dark:bg-card",
					Attributes: templ.Attributes{
						"maxlength":  services.MaxShoppingListNameLength,
						"aria-label": utils.T(ctx, locales.LK_ShoppingNewList),
					},
				})
				@categorySelect("new-list-category", g.ExpenseCategories[0], "w-full bg-card data-[size=default]:h-10 dark:bg-card", templ.Attributes{
					"aria-label": utils.T(ctx, locales.LK_ExpensesCategory),
				})
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10"}) {
					@components.T(locales.LK_ShoppingCreateList)
				}
			</form>
			<div class="mt-3 empty:hidden">
				@formError(errorMessage)
			</div>
		</section>
	}
}

// HouseholdPeople shows members and, for owners, invites
//
// inviteBaseURL is the absolute invite link without the code,
// infoMessage and errorMessage are the outcome of the last action, the info is a toast
// and the error shows by the action errorAt (a PeopleAt*)
templ HouseholdPeople(actor services.Membership, o services.HouseholdOverview, inviteBaseURL, infoMessage, errorAt, errorMessage string) {
	{{ isOwner := actor.Role == g.RoleOwner }}
	{{ errorFor := func(at string) string { return utils.IfElse(errorAt == at, errorMessage, "") } }}
	@appShell(o.Household.Name, &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionPeople}) {
		<header>
			<h1 class="doorplate">
				@components.T(locales.LK_NavPeople)
			</h1>
		</header>
		@VerifyEmailBanner(o.ActorEmailValidated)
		@toast(infoMessage)
		// the name board by the front door: who lives here, the biggest thing on the page
		<section aria-labelledby="members-title" class={ sheetClass }>
			<h2 id="members-title" class="sr-only">
				@components.T(locales.LK_HouseholdMembers)
			</h2>
			@liveRegionWith("members", "#invites", events.TopicPeople) {
				<p class="text-sm text-muted-foreground">
					@components.N(locales.LK_HouseholdCount, len(o.Members), i18n.M{"count": len(o.Members)})
				</p>
				<ul class="mt-2 divide-y">
					for _, m := range o.Members {
						<li class="flex flex-wrap items-start gap-3 py-3">
							// the same picture, or people colour and initial, as in the chat
							@personAvatar(m.UserID, m.AvatarKey, m.Username, avatar.SizeLg, "mt-0.5")
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center gap-x-2">
									<span class="font-heading text-xl leading-tight font-semibold break-words">{ m.Username }</span>
									if m.UserID == actor.UserID {
										<span class="rounded-full bg-claim px-2 text-xs font-semibold text-claim-foreground">
											@components.T(locales.LK_HouseholdYou)
										</span>
									}
								</div>
								<div class="text-sm text-muted-foreground">
									{ utils.T(ctx, locales.LK_HouseholdSince, RoleName(ctx, m.Role), formatDate(m.JoinedAt)) }
								</div>
							</div>
							if isOwner && m.Role != g.RoleOwner {
								// a native disclosure keeps the two actions out of sight until asked for, no script,
								// they show on their own row below the name, hx-preserve keeps it open through a live refresh
								<details id={ "manage-" + m.UserID.String() } hx-preserve class="group/manage">
									<summary
										aria-label={ utils.T(ctx, locales.LK_HouseholdManage) + " " + m.Username }
										class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-muted-foreground outline-none hover:bg-muted hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 group-open/manage:bg-muted [&::-webkit-details-marker]:hidden"
									>
										@navIcon("more", "size-5")
									</summary>
								</details>
								<div class="hidden w-full flex-wrap justify-end gap-2 [li:has(>details[open])>&]:flex">
									<form action={ householdURL(actor.HouseholdID, "members", m.UserID.String(), "promote") } method="post" hx-boost="true">
										@button.Button(button.Props{
											Type:    button.TypeSubmit,
											Variant: button.VariantOutline,
											Size:    button.SizeSm,
										}) {
											@components.T(locales.LK_HouseholdPromote)
										}
									</form>
									<form
										action={ householdURL(actor.HouseholdID, "members", m.UserID.String(), "remove") }
										method="post"
										hx-boost="true"
										hx-confirm={ utils.T(ctx, locales.LK_HouseholdRemove) + " " + m.Username + "?" }
									>
										@button.Button(button.Props{
											Type:    button.TypeSubmit,
											Variant: button.VariantDestructive,
											Size:    button.SizeSm,
										}) {
											@components.T(locales.LK_HouseholdRemove)
										}
									</form>
								</div>
							}
						</li>
					}
				</ul>
			}
			// outside the region, a refetch would clear it before it is read
			<div class="mt-3 empty:hidden">
				@formError(errorFor(PeopleAtMembers))
			</div>
		</section>
		if isOwner {
			<section aria-labelledby="invites-title">
				<h2 id="invites-title" class="text-xl font-semibold">
					@components.T(locales.LK_HouseholdInvites)
				</h2>
				<p class="mt-1 text-sm text-muted-foreground">
					@components.T(locales.LK_HouseholdInvitesDescription)
				</p>
				<div class={ utils.CN(sheetClass, "mt-3") }>
					<div id="invites">
						if len(o.Invites) == 0 {
							<p class="text-sm text-muted-foreground">
								@components.T(locales.LK_HouseholdNoInvites)
							</p>
						} else {
							<ul class="divide-y">
								for _, inv := range o.Invites {
									<li class="space-y-3 py-4 first:pt-0">
										<div class="flex flex-wrap items-center gap-2">
											<span class="key-tag mr-auto">{ inv.Code }</span>
											@copyButton(inv.Code, locales.LK_HouseholdCopyCode)
											<form action={ householdURL(actor.HouseholdID, "invites", inv.ID.String(), "delete") } method="post" hx-boost="true">
												@button.Button(button.Props{
													Type:    button.TypeSubmit,
													Variant: button.VariantGhost,
													Size:    button.SizeSm,
												}) {
													@components.T(locales.LK_HouseholdRevoke)
												}
											</form>
										</div>
										<div class="flex items-center gap-2">
											<input
												type="text"
												readonly
												value={ inviteBaseURL + inv.Code }
												aria-label={ utils.T(ctx, locales.LK_HouseholdInvites) }
												class="min-w-0 flex-1 rounded-lg border bg-background px-2 py-1.5 text-xs text-muted-foreground"
											/>
											@copyButton(inviteBaseURL+inv.Code, locales.LK_HouseholdCopyLink)
										</div>
										<div class="text-xs text-muted-foreground">
											{ utils.T(ctx, locales.LK_HouseholdExpires, formatDate(inv.ExpiresAt)) }
										</div>
									</li>
								}
							</ul>
						}
					</div>
					<div class="mt-4 border-t pt-4">
						if o.ActorEmailValidated {
							<form action={ householdURL(actor.HouseholdID, "invites") } method="post" hx-boost="true">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
									@components.T(locales.LK_HouseholdCreateInvite)
								}
							</form>
							<div class="mt-3 empty:hidden">
								@formError(errorFor(PeopleAtInvites))
							</div>
							<form
								action={ householdURL(actor.HouseholdID, "invites", "email") }
								method="post"
								hx-boost="true"
								class="mt-5 space-y-2"
							>
								@field.Label(field.LabelProps{For: "invite-email"}) {
									@components.T(locales.LK_HouseholdInviteEmailTitle)
								}
								<div class="flex gap-2">
									@input.Input(input.Props{
										ID:          "invite-email",
										Name:        "email",
										Type:        "email",
										Placeholder: "flatmate@example.com",
										Required:    true,
									})
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
										@components.T(locales.LK_HouseholdInviteEmailSubmit)
									}
								</div>
								@formError(errorFor(PeopleAtInviteEmail))
							</form>
						} else {
							<p class="text-sm text-muted-foreground">
								@components.T(locales.LK_HouseholdVerifyToInvite)
							</p>
						}
					</div>
				</div>
			</section>
		}
		<form
			action={ householdURL(actor.HouseholdID, "leave") }
			method="post"
			hx-boost="true"
			hx-confirm={ utils.T(ctx, locales.LK_HouseholdLeave) + "?" }
			class="space-y-2"
		>
			@formError(errorFor(PeopleAtLeave))
			@button.Button(button.Props{
				Type:    button.TypeSubmit,
				Variant: button.VariantGhost,
				Class:   "-ml-3 text-destructive hover:text-destructive",
			}) {
				@components.T(locales.LK_HouseholdLeave)
			}
		</form>
	}
}

var copyScript = templ.NewOnceHandle()

// copyButton copies value to the clipboard, web/assets/public/copy.js
templ copyButton(value string, label locales.LK) {
	@copyScript.Once() {
		<script src="/assets/copy.js"></script>
	}
	@button.Button(button.Props{
		Type:    button.TypeButton,
		Variant: button.VariantOutline,
		Size:    button.SizeSm,
		Class:   "shrink-0 [.no-clipboard_&]:hidden",
		Attributes: templ.Attributes{
			"data-copy":   value,
			"data-copied": utils.T(ctx, locales.LK_HouseholdCopied),
		},
	}) {
		@components.T(label)
	}
}

// personAvatar is a user's picture, or until it loads (or without one) their initial on the people colour,
// decoration next to their name
templ personAvatar(userID pgtype.UUID, avatarKey *string, name string, size avatar.Size, class string) {
	@avatar.Avatar(avatar.Props{Size: size, Class: class, Attributes: templ.Attributes{"aria-hidden": "true"}}) {
		if avatarKey != nil {
			@avatar.Image(avatar.ImageProps{Src: avatarURL(userID, *avatarKey)})
		}
		@avatar.Fallback(avatar.FallbackProps{Class: "bg-claim font-heading font-semibold text-claim-foreground group-data-[size=lg]/avatar:text-base"}) {
			{ initial(name) }
		}
	}
}
