package pages

import "roommates/web/components"
import "roommates/web/components/alert"
import "roommates/web/components/field"
import "roommates/web/components/input"
import "roommates/web/components/button"
import "roommates/internal/models"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"

templ Register(m models.Register) {
	@authCard(utils.T(ctx, locales.LK_RegistrationPageTitle), utils.T(ctx, locales.LK_RegistrationPageDescription)) {
		if m.Error != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "mb-5"}) {
				{ m.Error }
			}
		}
		@RegisterForm(m)
		<p class="mt-6 text-sm text-muted-foreground">
			@components.T(locales.LK_RegistrationPageAlreadyHaveAccount)
			<a
				href={ withNext(g.RouteLogin, m.Next) }
				class="font-medium text-foreground underline-offset-4 hover:underline ml-1"
			>
				@components.T(locales.LK_LoginPageSignIn)
			</a>
		</p>
	}
}

templ RegisterForm(m models.Register) {
	{{
		emailValidations := m.ValidateEmail()
		usernameValidations := m.ValidateUsername()
		passwordValidations := m.ValidatePassword()
		passwordMatchValidations := m.ValidatePasswordMatch()
	}}
	<form action={ g.RouteRegister } method="post" hx-boost="true" class="space-y-5">
		<input type="hidden" name="next" value={ m.Next }/>
		@field.Group() {
			<!-- Email -->
			@field.Field() {
				@field.Label(field.LabelProps{For: "email"}) {
					@components.T(locales.LK_Email)
				}
				@input.Input(input.Props{
					ID:          "email",
					Name:        "email",
					Type:        "email",
					Value:       m.Email,
					Placeholder: "you@example.com",
					Required:    true,
					Attributes: templ.Attributes{
						"autocomplete": "email",
						"aria-invalid": len(emailValidations) > 0,
					},
				})
				@components.ValidationErrors(emailValidations)
			}
			<!-- Username -->
			@field.Field() {
				@field.Label(field.LabelProps{For: "username"}) {
					@components.T(locales.LK_UsernameTitle)
				}
				@input.Input(input.Props{
					ID:       "username",
					Name:     "username",
					Type:     "text",
					Value:    m.Username,
					Required: true,
					Attributes: templ.Attributes{
						"autocomplete": "username",
						"aria-invalid": len(usernameValidations) > 0,
					},
				})
				@components.ValidationErrors(usernameValidations)
			}
			<!-- Password -->
			@field.Field() {
				@field.Label(field.LabelProps{For: "password"}) {
					@components.T(locales.LK_PasswordTitle)
				}
				@passwordInput(input.Props{
					ID:          "password",
					Name:        "password",
					Placeholder: utils.T(ctx, locales.LK_PasswordEnter),
					Required:    true,
					Attributes: templ.Attributes{
						"autocomplete": "new-password",
						"aria-invalid": len(passwordValidations) > 0,
					},
				})
				@components.ValidationErrors(passwordValidations)
			}
			<!-- Confirm password -->
			@field.Field() {
				@field.Label(field.LabelProps{For: "password_2"}) {
					@components.T(locales.LK_PasswordConfirm)
				}
				@passwordInput(input.Props{
					ID:       "password_2",
					Name:     "password_2",
					Required: true,
					Attributes: templ.Attributes{
						"autocomplete": "new-password",
						"aria-invalid": len(passwordMatchValidations) > 0,
					},
				})
				@components.ValidationErrors(passwordMatchValidations)
			}
			<!-- Submit -->
			@button.Button(button.Props{
				Type:  button.TypeSubmit,
				Class: "w-full",
			}) {
				@components.T(locales.LK_RegistrationPageSubmit)
			}
		}
	</form>
}
