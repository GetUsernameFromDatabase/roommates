package pages

import "roommates/web/components"
import "roommates/web/components/alert"
import "roommates/web/components/button"
import "roommates/internal/locales"
import "roommates/internal/routes"
import "roommates/internal/services"
import "roommates/internal/utils"
import g "roommates/internal/config"
import "github.com/jackc/pgx/v5/pgtype"

// DeletedBanner says a deleted household is read-only until it is purged, owners can restore it,
// it renders nothing for a household that is not deleted
templ DeletedBanner(m services.Membership) {
	if m.DeletedAt.Valid {
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive, Class: "flex flex-wrap items-center justify-between gap-2"}) {
			@alert.Title() {
				{ utils.T(ctx, locales.LK_OwnershipDeletedBanner, utils.FormatDate(ctx, services.PurgeDate(m.DeletedAt))) }
			}
			if m.Role == g.RoleOwner {
				@restoreForm(m.HouseholdID)
			}
		}
	}
}

// restoreForm undoes the deletion of a household, the page it is on is shown again
templ restoreForm(householdID pgtype.UUID) {
	<form action={ routes.URL(routes.HouseholdRestore, householdID) } method="post" hx-boost="true">
		@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
			@components.T(locales.LK_OwnershipRestore)
		}
	</form>
}

// DeleteHouseholdError is why deleting the household failed, swapped into the open delete dialog
templ DeleteHouseholdError(message string) {
	@formError(message)
}
