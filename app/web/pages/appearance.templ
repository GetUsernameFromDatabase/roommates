package pages

import "roommates/web/components"
import "roommates/web/components/button"
import "roommates/web/components/field"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"

var themeNames = map[string]locales.LK{
	"home":  locales.LK_AppearanceThemeHome,
	"plain": locales.LK_AppearanceThemePlain,
}

var modeNames = map[string]locales.LK{
	"system": locales.LK_AppearanceModeSystem,
	"light":  locales.LK_AppearanceModeLight,
	"dark":   locales.LK_AppearanceModeDark,
}

// AppearanceForm picks the theme and mode of this device, next is where to go after saving
templ AppearanceForm(next string) {
	{{ a := utils.GetAppearance(ctx) }}
	<section aria-labelledby="appearance-title" class="mt-4 border-t pt-6">
		<h2 id="appearance-title" class="text-base font-semibold">
			@components.T(locales.LK_AppearanceTitle)
		</h2>
		<form action={ g.RouteAppearance } method="post" class="mt-3 flex flex-wrap items-end gap-3">
			<input type="hidden" name={ g.QueryNext } value={ next }/>
			@appearanceSelect("theme", locales.LK_AppearanceTheme, utils.Themes, themeNames, a.Theme)
			@appearanceSelect("mode", locales.LK_AppearanceMode, utils.Modes, modeNames, a.Mode)
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Class: "h-10"}) {
				@components.T(locales.LK_CommonSave)
			}
		</form>
	</section>
}

templ appearanceSelect(name string, label locales.LK, values []string, names map[string]locales.LK, selected string) {
	<div class="flex flex-col gap-1.5">
		@field.Label(field.LabelProps{For: "appearance-" + name}) {
			@components.T(label)
		}
		<select
			id={ "appearance-" + name }
			name={ name }
			class="h-10 rounded-lg border border-input bg-card px-3 text-sm outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
		>
			for _, v := range values {
				<option value={ v } selected?={ v == selected }>{ utils.T(ctx, names[v]) }</option>
			}
		</select>
	</div>
}
