package pages

import "roommates/web/components"
import "roommates/web/components/button"
import "roommates/web/components/calendar"
import "roommates/web/components/checkbox"
import "roommates/web/components/field"
import "roommates/web/components/icon"
import "roommates/web/components/input"
import "roommates/web/components/popover"
import "roommates/web/components/radiogroup"
import "roommates/web/components/select"
import "roommates/internal/db/dbqueries"
import "roommates/internal/services"
import "roommates/internal/events"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"
import "slices"
import "time"

// HouseholdExpenses shows who owes whom, settlements waiting for confirmation and the expenses,
// errorMessage is the outcome of an "I paid"
templ HouseholdExpenses(actor services.Membership, o services.ExpensesOverview, errorMessage string) {
	{{ expensesURL := householdURL(actor.HouseholdID, "expenses") }}
	@appShell(utils.T(ctx, locales.LK_NavExpenses), &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionExpenses}) {
		<header class="flex items-end justify-between gap-3">
			<h1 class="doorplate">
				@components.T(locales.LK_NavExpenses)
			</h1>
			@button.Button(button.Props{Href: string(expensesURL) + "/new", Size: button.SizeLg, Class: "h-10 shrink-0"}) {
				@components.T(locales.LK_ExpensesNew)
			}
		</header>
		// outside the region, a refetch would clear it before it is read
		@formError(errorMessage)
		// the "I paid" amount is the debt, when that changes the amount should too
		@liveRegion("expenses", events.TopicExpenses) {
			{{ settled := len(o.Debts) == 0 && len(o.Pending) == 0 && len(o.Expenses) > 0 }}
			<div class="flex flex-col gap-8 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
				if len(o.Pending) > 0 || len(o.Debts) > 0 || settled {
					<div class="flex min-w-0 flex-col gap-6">
						if len(o.Pending) > 0 {
							<section aria-labelledby="pending-title">
								<h2 id="pending-title" class="sr-only">
									@components.T(locales.LK_ExpensesPending)
								</h2>
								<ul class="flex flex-col gap-6">
									for _, p := range o.Pending {
										<li class="till-slip">
											@pendingSlip(actor, p)
										</li>
									}
								</ul>
							</section>
						}
						if len(o.Debts) > 0 || settled {
							<section aria-labelledby="balances-title">
								<h2 id="balances-title" class="sr-only">
									@components.T(locales.LK_ExpensesBalances)
								</h2>
								if settled {
									<div class="till-slip">
										<p class="till-paper flex justify-center py-8">
											<span class="stamp stamp-settled">
												@components.T(locales.LK_ExpensesSettled)
											</span>
										</p>
									</div>
								} else {
									<ul class="flex flex-col gap-6">
										for _, d := range yoursFirst(o.Debts, actor) {
											<li class="till-slip">
												<div class="till-paper">
													@debtBreakdown(actor, d)
													if d.From == actor.UserID {
														<form action={ householdURL(actor.HouseholdID, "settlements") } method="post" hx-boost="true" class="till-perforation flex gap-2">
															<input type="hidden" name="to" value={ d.To.String() }/>
															@input.Input(input.Props{
																Name:  "amount",
																Type:  "text",
																Value: services.FormatCentsInput(d.Cents),
																Class: "h-11 min-w-0 flex-1",
																Attributes: templ.Attributes{
																	"inputmode":  "decimal",
																	"required":   true,
																	"aria-label": utils.T(ctx, locales.LK_ExpensesAmount),
																},
															})
															@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-11"}) {
																@components.T(locales.LK_ExpensesIPaid)
															}
														</form>
													}
												</div>
											</li>
										}
									</ul>
								}
							</section>
						}
					</div>
				}
				<section class="till-roll">
					<div class="till-paper">
						if len(o.Expenses) == 0 {
							<p class="text-muted-foreground">
								@components.T(locales.LK_ExpensesNone)
							</p>
						} else {
							<ul class="divide-y divide-dashed">
								for _, e := range o.Expenses {
									<li>
										<a href={ householdURL(actor.HouseholdID, "expenses", e.ID.String()) } class="block min-h-12 py-2 hover:underline">
											<span class="till-line">
												<span class="min-w-0 font-heading font-semibold break-words">{ e.Title }</span>
												<span aria-hidden="true" class="till-leader"></span>
												<span class="shrink-0 font-semibold tabular-nums">{ utils.FormatMoney(ctx, e.AmountCents, actor.Currency) }</span>
											</span>
											<span class="flex flex-wrap justify-between gap-x-3 text-xs text-muted-foreground">
												<span>{ paidByLine(ctx, actor, e.PayerID, e.PayerName, e.IncurredOn) }</span>
												<span>{ CategoryName(ctx, e.Category) }</span>
											</span>
										</a>
									</li>
								}
							</ul>
						}
					</div>
				</section>
			</div>
		}
	}
}

// pendingSlip is a payment the receiver has not confirmed yet, stamped until they do
templ pendingSlip(actor services.Membership, p dbqueries.ListPendingSettlementsRow) {
	{{ settlementURL := householdURL(actor.HouseholdID, "settlements", p.ID.String()) }}
	<div class="till-paper space-y-3">
		<div class="flex items-start justify-between gap-3">
			<p class="min-w-0 break-words">
				{ pairPhrase(ctx, actor, p.FromUser, p.FromName, p.ToUser, p.ToName,
					locales.LK_ExpensesPaidTo, locales.LK_ExpensesYouPaidTo, locales.LK_ExpensesPaidYou) }
				<span class="block font-heading text-3xl font-semibold tabular-nums">{ utils.FormatMoney(ctx, p.AmountCents, actor.Currency) }</span>
			</p>
			<span class="stamp mt-1 max-w-32 shrink-0">
				@components.T(locales.LK_ExpensesPending)
			</span>
		</div>
		<div class="flex flex-wrap gap-2">
			if p.ToUser == actor.UserID {
				<form action={ settlementURL + "/confirm" } method="post" hx-boost="true">
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "h-11 px-4"}) {
						@components.T(locales.LK_ExpensesConfirm)
					}
				</form>
			}
			<form action={ settlementURL + "/delete" } method="post" hx-boost="true">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Class: "h-11 px-3 text-destructive"}) {
					if p.ToUser == actor.UserID {
						@components.T(locales.LK_ExpensesReject)
					} else {
						@components.T(locales.LK_ExpensesCancel)
					}
				}
			</form>
		</div>
	</div>
}

// debtBreakdown is "who owes whom how much", opening to the unpaid shares and
// payments between the two that add up to it
templ debtBreakdown(actor services.Membership, d services.Debt) {
	{{ yours := d.From == actor.UserID || d.To == actor.UserID }}
	<details class="group">
		<summary class="flex cursor-pointer list-none items-start justify-between gap-3 rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden">
			<span class="min-w-0 break-words">
				{ pairPhrase(ctx, actor, d.From, d.FromName, d.To, d.ToName,
					locales.LK_ExpensesOwes, locales.LK_ExpensesYouOwe, locales.LK_ExpensesOwesYou) }
				<span class={ utils.CN("block font-heading font-semibold tabular-nums", utils.IfElse(yours, "text-3xl", "text-lg"), itemClass(actor, d, d.Cents)) }>{ utils.FormatMoney(ctx, d.Cents, actor.Currency) }</span>
			</span>
			@navIcon("chevron-down", "mt-0.5 size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180 motion-reduce:transition-none")
		</summary>
		<ul class="mt-3 text-sm">
			for _, it := range d.Items {
				<li class="py-1.5">
					<div class="till-line">
						if it.Row.ExpenseID.Valid {
							<a href={ householdURL(actor.HouseholdID, "expenses", it.Row.ExpenseID.String()) } class="min-w-0 break-words underline-offset-4 hover:underline">{ it.Row.Title }</a>
						} else {
							// a settlement row runs the other way, ToUser is who paid
							<span class="min-w-0 break-words">
								{ pairPhrase(ctx, actor, it.Row.ToUser, it.Row.ToName, it.Row.FromUser, it.Row.FromName,
									locales.LK_ExpensesPaidTo, locales.LK_ExpensesYouPaidTo, locales.LK_ExpensesPaidYou) }
							</span>
						}
						<span aria-hidden="true" class="till-leader"></span>
						<span class={ utils.CN("shrink-0 tabular-nums", itemClass(actor, d, it.Cents)) }>{ formatSignedMoney(ctx, it.Cents, actor.Currency) }</span>
					</div>
					<span class="block text-xs text-muted-foreground">
						if it.Row.ExpenseID.Valid {
							{ paidByLine(ctx, actor, it.Row.ToUser, it.Row.ToName, it.Row.OnDate) }
						} else {
							{ formatDay(it.Row.OnDate) }
						}
					</span>
				</li>
			}
			<li class="mt-1.5 flex items-baseline justify-between gap-3 border-t border-dashed pt-1.5 font-semibold">
				@components.T(locales.LK_ExpensesTotal)
				<span class="shrink-0 tabular-nums">{ utils.FormatMoney(ctx, d.Cents, actor.Currency) }</span>
			</li>
		</ul>
	</details>
}

var expenseSplitScript = templ.NewOnceHandle()

// ExpenseEditor is the new expense form, the actor pays it
templ ExpenseEditor(actor services.Membership, members []dbqueries.ListActiveMembersRow, in services.ExpenseInput, errorMessage string) {
	{{ expensesURL := householdURL(actor.HouseholdID, "expenses") }}
	@appShell(utils.T(ctx, locales.LK_ExpensesNew), &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionExpenses}) {
		@doorplateHeader(expensesURL, utils.T(ctx, locales.LK_ExpensesBack), utils.T(ctx, locales.LK_ExpensesNew))
		<div class="till-slip w-full max-w-md">
			<form action={ expensesURL } method="post" hx-boost="true" data-expense-split={ actor.UserID.String() } class="till-paper space-y-4">
				// the shopping items this expense paid for
				if in.ListID.Valid {
					<input type="hidden" name="list" value={ in.ListID.String() }/>
				}
				if in.ItemID.Valid {
					<input type="hidden" name="item" value={ in.ItemID.String() }/>
				}
				@formError(errorMessage)
				@field.Field() {
					@field.Label(field.LabelProps{For: "expense-title"}) {
						@components.T(locales.LK_ExpensesWhat)
					}
					@input.Input(input.Props{
						ID:       "expense-title",
						Name:     "title",
						Type:     "text",
						Value:    in.Title,
						Required: true,
						Class:    tillFieldClass,
						Attributes: templ.Attributes{
							"maxlength": services.MaxExpenseTitleLength,
						},
					})
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "expense-amount"}) {
						@components.T(locales.LK_ExpensesAmount)
					}
					@input.Input(input.Props{
						ID:       "expense-amount",
						Name:     "amount",
						Type:     "text",
						Value:    in.Amount,
						Required: true,
						Class:    utils.CN(tillFieldClass, "h-14 font-heading text-3xl font-semibold tabular-nums md:text-3xl"),
						Attributes: templ.Attributes{
							"inputmode":   "decimal",
							"placeholder": "0,00",
						},
					})
				}
				<div class="grid grid-cols-2 gap-3">
					@field.Field() {
						@field.Label(field.LabelProps{For: "expense-date-popover-trigger"}) {
							@components.T(locales.LK_ExpensesDate)
						}
						@datePicker("expense-date", "incurred_on", in.IncurredOn)
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "expense-category-trigger"}) {
							@components.T(locales.LK_ExpensesCategory)
						}
						@categorySelect("expense-category", in.Category, utils.CN(tillFieldClass, "w-full data-[size=default]:h-11"), nil)
					}
				</div>
				<fieldset class="space-y-2">
					<legend class="text-sm font-medium">
						@components.T(locales.LK_ExpensesSplit)
					</legend>
					@radiogroup.RadioGroup(radiogroup.Props{Name: "split", DefaultValue: utils.IfElse(in.Custom, "custom", "equal"), Class: "gap-0"}) {
						@splitOption("split-equal", "equal", locales.LK_ExpensesSplitEqual)
						@splitOption("split-custom", "custom", locales.LK_ExpensesSplitCustom)
					}
					<ul class="divide-y divide-dashed">
						for _, m := range members {
							<li class="till-line items-center py-1">
								<label class="flex min-h-11 min-w-0 items-center gap-3">
									@checkbox.Checkbox(checkbox.Props{
										Name:           "member",
										Value:          m.UserID.String(),
										DefaultChecked: slices.Contains(in.Members, m.UserID),
										Class:          "size-5",
									})
									<span class="break-words">{ m.Username }</span>
								</label>
								<span aria-hidden="true" class="till-leader"></span>
								@input.Input(input.Props{
									Name:  "share-" + m.UserID.String(),
									Type:  "text",
									Value: in.Shares[m.UserID],
									// an equal split is a result, not a field to fill in
									Class: utils.CN(tillFieldClass, "w-28 shrink-0 text-right tabular-nums read-only:border-transparent"),
									Attributes: templ.Attributes{
										"inputmode":   "decimal",
										"placeholder": "0,00",
										"aria-label":  utils.T(ctx, locales.LK_ExpensesAmount) + ": " + m.Username,
									},
								})
							</li>
						}
					</ul>
				</fieldset>
				<div class="till-perforation">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "w-full"}) {
						@components.T(locales.LK_ExpensesAdd)
					}
				</div>
			</form>
		</div>
		// after the form, it fills in the shares as soon as it runs
		@expenseSplitScript.Once() {
			<script src="/assets/expense-split.js"></script>
		}
	}
}

// ExpensePage shows an expense with its shares and files, the payer marks shares paid,
// uploadError is the outcome of an upload
templ ExpensePage(actor services.Membership, e services.Expense, uploadError string) {
	{{ expenseURL := householdURL(actor.HouseholdID, "expenses", e.Expense.ID.String()) }}
	{{ isPayer := e.Expense.PayerID == actor.UserID }}
	@appShell(e.Expense.Title, &HouseholdNav{HouseholdID: actor.HouseholdID, Section: SectionExpenses}) {
		@doorplateHeader(householdURL(actor.HouseholdID, "expenses"), utils.T(ctx, locales.LK_ExpensesBack), e.Expense.Title)
		<div class="flex flex-col gap-8 lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
			<section class="till-slip" aria-labelledby="shares-title">
				<div class="till-paper">
					<h2 id="shares-title" class="sr-only">
						@components.T(locales.LK_ExpensesShares)
					</h2>
					<p class="flex flex-wrap justify-between gap-x-3 text-xs text-muted-foreground">
						<span>{ paidByLine(ctx, actor, e.Expense.PayerID, e.Expense.PayerName, e.Expense.IncurredOn) }</span>
						<span>{ CategoryName(ctx, e.Expense.Category) }</span>
					</p>
					@liveRegion("shares", events.TopicExpenses) {
						<ul class="mt-1 divide-y divide-dashed">
							for _, sh := range e.Shares {
								<li class="py-2">
									<div class="till-line">
										<span class="min-w-0 break-words">{ personName(ctx, actor, sh.UserID, sh.Username) }</span>
										<span aria-hidden="true" class="till-leader"></span>
										<span class="shrink-0 font-semibold tabular-nums">{ utils.FormatMoney(ctx, sh.AmountCents, actor.Currency) }</span>
									</div>
									// the payer's own share is not owed to anyone
									if sh.UserID != e.Expense.PayerID {
										<div class="mt-1 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
											@sharePaidStamp(sh.PaidAt.Valid)
											if isPayer {
												<form action={ expenseURL + "/shares/" + templ.SafeURL(sh.UserID.String()) + "/paid" } method="post" hx-boost="true">
													<input type="hidden" name="paid" value={ utils.IfElse(sh.PaidAt.Valid, "0", "1") }/>
													@button.Button(button.Props{
														Type:    button.TypeSubmit,
														Variant: utils.IfElse(sh.PaidAt.Valid, button.VariantGhost, button.VariantSecondary),
														Class:   "h-11 px-3",
													}) {
														if sh.PaidAt.Valid {
															@components.T(locales.LK_ExpensesMarkUnpaid)
														} else {
															@components.T(locales.LK_ExpensesMarkPaid)
														}
													}
												</form>
											}
										</div>
									}
								</li>
							}
						</ul>
					}
					<p class="till-perforation flex items-baseline justify-between gap-3 font-semibold">
						@components.T(locales.LK_ExpensesTotal)
						<span class="shrink-0 font-heading text-3xl tabular-nums">{ utils.FormatMoney(ctx, e.Expense.AmountCents, actor.Currency) }</span>
					</p>
				</div>
			</section>
			@attachedFiles(actor, expenseURL, e.Files, locales.LK_ExpensesReceiptHint, uploadError)
		</div>
		<div class="flex flex-wrap gap-2">
			@button.Button(button.Props{Href: string(householdURL(actor.HouseholdID, "expenses", "new")) + "?from=" + e.Expense.ID.String(), Variant: button.VariantSecondary, Size: button.SizeLg}) {
				@components.T(locales.LK_ExpensesCopy)
			}
			if isPayer {
				<form
					action={ expenseURL + "/delete" }
					method="post"
					hx-boost="true"
					hx-confirm={ utils.T(ctx, locales.LK_CommonDelete) + "?" }
					class="ml-auto"
				>
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantOutline,
						Size:    button.SizeLg,
						Class:   "text-destructive",
					}) {
						@components.T(locales.LK_CommonDelete)
					}
				</form>
			}
		</div>
	}
}

// tillFieldClass is a line to write on, the input's ring stays as the focus mark because
// a read only share has no border to show it
const tillFieldClass = "h-11 rounded-none border-0 border-b-2 border-dotted border-foreground/40 bg-transparent px-1 shadow-none dark:bg-transparent"

var datePickerScript = templ.NewOnceHandle()

// datePicker is a required day as the server's DateLayout, web/assets/public/date-picker.js
// copies the calendar's pick to the hidden input, the calendar itself is portaled out of the form
templ datePicker(id, name, value string) {
	@datePickerScript.Once() {
		<script src="/assets/date-picker.js"></script>
	}
	{{ day, _ := time.Parse(services.DateLayout, value) }}
	<input type="hidden" id={ id } name={ name } value={ value }/>
	@popover.Popover(popover.Props{ID: id + "-popover"}) {
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Class:      utils.CN(tillFieldClass, "w-full justify-between font-normal tabular-nums hover:bg-transparent dark:hover:bg-transparent aria-expanded:bg-transparent"),
			Attributes: popover.Trigger(ctx),
		}) {
			<span id={ id + "-text" }>{ value }</span>
			@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground", Attributes: templ.Attributes{"aria-hidden": "true"}})
		}
		@popover.Content(popover.ContentProps{Class: "w-auto p-0", Side: popover.SideBottom, Align: popover.AlignStart}) {
			@calendar.Calendar(calendar.Props{
				Mode:         calendar.ModeSingle,
				Selected:     day,
				DefaultMonth: day,
				Required:     utils.Ptr(true),
				Locale:       utils.GetLocaleString(ctx),
				Attributes: templ.Attributes{
					"data-date-input":     id,
					"data-label-previous": utils.T(ctx, locales.LK_ExpensesDatePreviousMonth),
					"data-label-next":     utils.T(ctx, locales.LK_ExpensesDateNextMonth),
					"data-label-today":    utils.T(ctx, locales.LK_ExpensesDateToday),
					"data-label-selected": utils.T(ctx, locales.LK_ExpensesDateSelected),
				},
			})
		}
	}
}

// categorySelect submits the category, class and attrs go on the trigger, a label points
// at id + "-trigger"
templ categorySelect(id, selected, class string, attrs templ.Attributes) {
	{{
	items := utils.Map(g.ExpenseCategories, func(c string) selectcomp.ItemData {
		return selectcomp.ItemData{Value: c, Label: CategoryName(ctx, c)}
	})
	}}
	@selectcomp.Select(selectcomp.Props{ID: id, Name: "category", Items: items, DefaultValue: selected}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: class, Attributes: attrs}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			for _, it := range items {
				@selectcomp.Item(selectcomp.ItemProps{Value: it.Value}) {
					{ CategoryName(ctx, it.Value) }
				}
			}
		}
	}
}

templ splitOption(id, value string, label locales.LK) {
	@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "min-h-11"}) {
		@radiogroup.Item(radiogroup.ItemProps{ID: id, Value: value})
		@field.Label(field.LabelProps{For: id, Class: "min-h-11 text-base font-normal"}) {
			@components.T(label)
		}
	}
}

// sharePaidStamp stamps only what is done, a share still open is plain text
templ sharePaidStamp(paid bool) {
	if paid {
		<span class="stamp stamp-paid">
			@components.T(locales.LK_ExpensesSharePaid)
		</span>
	} else {
		<span class="text-sm text-muted-foreground">
			@components.T(locales.LK_ExpensesShareUnpaid)
		</span>
	}
}
