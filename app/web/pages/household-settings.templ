package pages

import "strconv"
import "roommates/web/components"
import "roommates/web/components/alert"
import "roommates/web/components/alertdialog"
import "roommates/web/components/button"
import "roommates/web/components/field"
import "roommates/web/components/input"
import "roommates/web/components/select"
import "roommates/internal/locales"
import "roommates/internal/routes"
import "roommates/internal/services"
import "roommates/internal/utils"
import g "roommates/internal/config"

// HouseholdSettingsSection is the household's name and currency, owners post to
// routes.HouseholdUpdate and only this section is swapped, members see them read-only
// the currency is locked while a debt is open, errorMessage and infoMessage show by the save button
templ HouseholdSettingsSection(actor services.Membership, h services.HouseholdSettings, errorMessage, infoMessage string) {
	{{ owner := actor.Role == g.RoleOwner }}
	<section id="household-settings" aria-labelledby="household-settings-title" class={ sheetClass + " flex flex-col gap-4" }>
		<h2 id="household-settings-title" class="text-xl font-semibold">
			@components.T(locales.LK_HouseholdSettingsTitle)
		</h2>
		if owner {
			<form
				action={ routes.URL(routes.HouseholdUpdate, actor.HouseholdID) }
				method="post"
				hx-post={ routes.URL(routes.HouseholdUpdate, actor.HouseholdID) }
				hx-target="#household-settings"
				hx-swap="outerHTML"
				hx-disinherit="*"
				class="flex flex-col items-start gap-4"
			>
				<div class="flex w-full flex-col gap-2">
					<label for="household-name" class="text-sm font-medium">
						@components.T(locales.LK_HouseholdName)
					</label>
					@input.Input(input.Props{
						ID:       "household-name",
						Name:     "name",
						Type:     "text",
						Value:    h.Name,
						Required: true,
						Class:    "h-11",
						Attributes: templ.Attributes{
							"maxlength": services.MaxHouseholdNameLength,
						},
					})
				</div>
				<div class="flex w-full flex-col gap-2">
					<label for="household-currency-trigger" class="text-sm font-medium">
						@components.T(locales.LK_HouseholdSettingsCurrency)
					</label>
					@currencySelect(h)
					if !h.Settled {
						<p id="household-currency-locked" class="text-sm text-muted-foreground">
							@components.T(locales.LK_HouseholdSettingsCurrencyLocked)
						</p>
					}
				</div>
				<div class="flex w-full flex-col gap-2">
					<label for="household-time-zone-trigger" class="text-sm font-medium">
						@components.T(locales.LK_HouseholdSettingsTimeZone)
					</label>
					@timeZoneSelect(h)
				</div>
				<div class="flex w-full flex-col gap-2">
					<label for="household-reminder-hour-trigger" class="text-sm font-medium">
						@components.T(locales.LK_HouseholdSettingsReminderHour)
					</label>
					@reminderHourSelect(h)
					<p id="household-reminder-hint" class="text-sm text-muted-foreground">
						@components.T(locales.LK_HouseholdSettingsReminderHint)
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "h-11"}) {
						@components.T(locales.LK_CommonSave)
					}
					<span role="status" class="text-sm text-muted-foreground empty:hidden">{ infoMessage }</span>
				</div>
				@formError(errorMessage)
			</form>
			if !actor.DeletedAt.Valid {
				@deleteHousehold(actor, h)
			}
		} else {
			<dl class="flex flex-col gap-3">
				<div>
					<dt class="text-sm text-muted-foreground">
						@components.T(locales.LK_HouseholdName)
					</dt>
					<dd class="font-medium break-words">{ h.Name }</dd>
				</div>
				<div>
					<dt class="text-sm text-muted-foreground">
						@components.T(locales.LK_HouseholdSettingsCurrency)
					</dt>
					<dd class="font-medium">{ h.Currency }</dd>
				</div>
				<div>
					<dt class="text-sm text-muted-foreground">
						@components.T(locales.LK_HouseholdSettingsTimeZone)
					</dt>
					<dd class="font-medium">{ timeZoneLabel(h.TimeZone) }</dd>
				</div>
				<div>
					<dt class="text-sm text-muted-foreground">
						@components.T(locales.LK_HouseholdSettingsReminderHour)
					</dt>
					<dd class="font-medium">{ reminderHourLabel(h.ReminderHour) }</dd>
				</div>
			</dl>
		}
	</section>
}

// deleteHousehold asks an owner to type the household's name, open debts do not stop it but
// are listed with the CSV downloads, an error is swapped into #household-delete-error
templ deleteHousehold(actor services.Membership, h services.HouseholdSettings) {
	{{ days := int(g.HouseholdPurgeAfter.Hours() / 24) }}
	<div class="flex flex-col items-start gap-3 border-t pt-4">
		<h3 class="font-semibold text-destructive">
			@components.T(locales.LK_OwnershipDeleteTitle)
		</h3>
		<p class="text-sm text-muted-foreground">
			{ utils.T(ctx, locales.LK_OwnershipDeleteDescription, days) }
		</p>
		@alertdialog.AlertDialog(alertdialog.Props{ID: "delete-household", Open: nil, DefaultOpen: false}) {
			@button.Button(button.Props{Variant: button.VariantDestructive, Class: "h-11", Attributes: alertdialog.Trigger(ctx)}) {
				@components.T(locales.LK_OwnershipDeleteTitle)
			}
			@alertdialog.Content(alertdialog.ContentProps{Class: "max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] overflow-y-auto", Attributes: nil, Size: ""}) {
				<form action={ routes.URL(routes.HouseholdDelete, actor.HouseholdID) } method="post" hx-boost="true" class="grid gap-4">
					@alertdialog.Header(alertdialog.HeaderProps{ID: "", Class: "", Attributes: nil}) {
						@alertdialog.Title(alertdialog.TitleProps{ID: "", Class: "", Attributes: nil}) {
							@components.T(locales.LK_OwnershipDeleteTitle)
						}
						@alertdialog.Description(alertdialog.DescriptionProps{ID: "", Class: "", Attributes: nil}) {
							{ utils.T(ctx, locales.LK_OwnershipDeleteDescription, days) }
						}
					}
					if len(h.Debts) > 0 {
						@alert.Alert(alert.Props{ID: "", Class: "gap-2", Attributes: nil, Variant: alert.VariantDestructive}) {
							@alert.Title(alert.TitleProps{ID: "", Class: "", Attributes: nil}) {
								@components.T(locales.LK_OwnershipDeleteOpenDebts)
							}
							<ul class="list-disc pl-5">
								for _, d := range h.Debts {
									<li>{ utils.T(ctx, locales.LK_OwnershipDeleteDebt, utils.MemberName(ctx, d.FromName), utils.MemberName(ctx, d.ToName), utils.FormatMoney(ctx, d.Cents, h.Currency)) }</li>
								}
							</ul>
						}
						@expenseExports(actor)
					}
					@field.Field() {
						@field.Label(field.LabelProps{For: "delete-household-name"}) {
							{ utils.T(ctx, locales.LK_OwnershipDeleteConfirmLabel, h.Name) }
						}
						// the server checks the name, its error shows below the field
						@input.Input(input.Props{
							ID:       "delete-household-name",
							Name:     "name",
							Type:     "text",
							Required: true,
							Class:    "h-11",
							Attributes: templ.Attributes{
								"autocomplete":     "off",
								"aria-describedby": "household-delete-error",
							},
						})
						<div id="household-delete-error"></div>
					}
					@alertdialog.Footer(alertdialog.FooterProps{ID: "", Class: "", Attributes: nil}) {
						@alertdialog.Cancel(alertdialog.CancelProps{ID: "", Class: "h-11", Attributes: nil, Variant: "", Size: ""}) {
							@components.T(locales.LK_CommonCancel)
						}
						@alertdialog.Action(alertdialog.ActionProps{ID: "", Class: "h-11", Attributes: templ.Attributes{"type": "submit"}, Variant: button.VariantDestructive, Size: ""}) {
							@components.T(locales.LK_OwnershipDeleteTitle)
						}
					}
				</form>
			}
		}
	</div>
}

// timeZoneSelect has no search, the kit select jumps to an option by typing its first letters
templ timeZoneSelect(h services.HouseholdSettings) {
	{{
		items := utils.Map(h.TimeZones, func(z string) selectcomp.ItemData {
			return selectcomp.ItemData{Value: z, Label: timeZoneLabel(z)}
		})
	}}
	@selectcomp.Select(selectcomp.Props{ID: "household-time-zone", Name: "time_zone", Items: items, DefaultValue: h.TimeZone}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "bg-card data-[size=default]:h-11 dark:bg-card"}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			for _, z := range h.TimeZones {
				@selectcomp.Item(selectcomp.ItemProps{Value: z}) {
					{ timeZoneLabel(z) }
				}
			}
		}
	}
}

templ reminderHourSelect(h services.HouseholdSettings) {
	{{
		hours := make([]int, 24)
		for i := range hours {
			hours[i] = i
		}
		items := utils.Map(hours, func(i int) selectcomp.ItemData {
			return selectcomp.ItemData{Value: strconv.Itoa(i), Label: reminderHourLabel(i)}
		})
	}}
	@selectcomp.Select(selectcomp.Props{ID: "household-reminder-hour", Name: "reminder_hour", Items: items, DefaultValue: strconv.Itoa(h.ReminderHour)}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "bg-card data-[size=default]:h-11 dark:bg-card", Attributes: templ.Attributes{"aria-describedby": "household-reminder-hint"}}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			for _, i := range hours {
				@selectcomp.Item(selectcomp.ItemProps{Value: strconv.Itoa(i)}) {
					{ reminderHourLabel(i) }
				}
			}
		}
	}
}

// currencySelect is disabled while a debt is open, a disabled field posts nothing,
// so the kept currency goes in a hidden input
templ currencySelect(h services.HouseholdSettings) {
	{{
		items := utils.Map(services.HouseholdCurrencies, func(c string) selectcomp.ItemData {
			return selectcomp.ItemData{Value: c, Label: c}
		})
	}}
	if !h.Settled {
		<input type="hidden" name="currency" value={ h.Currency }/>
	}
	@selectcomp.Select(selectcomp.Props{ID: "household-currency", Name: utils.IfElse(h.Settled, "currency", ""), Items: items, DefaultValue: h.Currency, Disabled: !h.Settled}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{Class: "bg-card data-[size=default]:h-11 dark:bg-card", Attributes: templ.Attributes{"aria-describedby": utils.IfElse(h.Settled, "", "household-currency-locked")}}) {
			@selectcomp.Value()
		}
		@selectcomp.Content() {
			for _, c := range services.HouseholdCurrencies {
				@selectcomp.Item(selectcomp.ItemProps{Value: c}) {
					{ c }
				}
			}
		}
	}
}
