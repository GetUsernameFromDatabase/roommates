package pages

import "roommates/web/components"
import "roommates/web/components/field"
import "roommates/web/components/input"
import "roommates/web/components/inputgroup"
import "roommates/web/components/button"
import "roommates/internal/models"
import g "roommates/internal/config"
import "roommates/internal/locales"
import "roommates/internal/utils"

// authCard is the layout of the sign in pages: the front door of the home on its
// wall, the form on a linen sheet beside it, under it on phones
templ authCard(title, description string) {
	@guestShell("") {
		<div class="grid min-h-svh grid-rows-[auto_1fr] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:grid-rows-1">
			<div class="front-door-wall">
				@frontDoor("/") {
					@components.T(locales.LK_AppTitle)
				}
			</div>
			<main class="bg-card px-4 py-10 text-card-foreground sm:px-10 lg:flex lg:items-center lg:px-16">
				<div class="mx-auto w-full max-w-sm lg:mx-0">
					<h1 class="text-[2rem] leading-tight font-semibold">{ title }</h1>
					if description != "" {
						<p class="mt-2 text-muted-foreground">{ description }</p>
					}
					<div class="mt-8">
						{ children... }
					</div>
				</div>
			</main>
		</div>
	}
}

// frontDoor is a door of the home with children on its plate, it swings ajar on
// hover and open while a form posts, see .front-door in globals.css
templ frontDoor(href templ.SafeURL) {
	<a href={ href } class="front-door">
		<span class="front-door-transom" aria-hidden="true"></span>
		<span class="front-door-opening">
			<span class="front-door-leaf">
				<span class="front-door-plate">
					{ children... }
				</span>
				<span class="front-door-handle" aria-hidden="true"></span>
			</span>
		</span>
		<span class="front-door-step" aria-hidden="true"></span>
	</a>
}

var revealPasswordScript = templ.NewOnceHandle()

// passwordInput is a password input with a toggle that shows it as text and hides
// it again, web/assets/public/reveal-password.js
//
// it uses only ID, Name, Placeholder, Required and Attributes of p
templ passwordInput(p input.Props) {
	@revealPasswordScript.Once() {
		<script src="/assets/reveal-password.js"></script>
	}
	{{
		// shown as text the browser would spell check it, sending it to a server,
		// and phone keyboards would correct it
		attrs := templ.Attributes{
			"required":       p.Required,
			"spellcheck":     "false",
			"autocapitalize": "none",
			"autocorrect":    "off",
		}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@inputgroup.InputGroup() {
		@inputgroup.Input(inputgroup.InputProps{
			ID:          p.ID,
			Name:        p.Name,
			Type:        "password",
			Placeholder: p.Placeholder,
			Attributes:  attrs,
		})
		@inputgroup.Addon(inputgroup.AddonProps{Align: inputgroup.AlignInlineEnd}) {
			@inputgroup.Button(inputgroup.ButtonProps{
				Size: inputgroup.ButtonSizeIconXs,
				Attributes: templ.Attributes{
					"data-reveal":   p.ID,
					"aria-controls": p.ID,
					"aria-pressed":  "false",
					"aria-label":    utils.T(ctx, locales.LK_PasswordShow),
				},
			}) {
				// lucide eye and eye-off, by aria-pressed
				<svg class="in-aria-pressed:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
					<circle cx="12" cy="12" r="3"></circle>
				</svg>
				<svg class="hidden in-aria-pressed:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
					<path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
					<path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
					<path d="m2 2 20 20"></path>
				</svg>
			}
		}
	}
}

templ ForgotPassword(m models.EmailForm) {
	{{ emailValidations := m.ValidateEmail() }}
	@authCard(utils.T(ctx, locales.LK_ForgotPasswordPageTitle), utils.T(ctx, locales.LK_ForgotPasswordPageDescription)) {
		<form action={ g.RouteForgotPassword } method="post" hx-boost="true" class="space-y-5">
			@field.Field() {
				@field.Label(field.LabelProps{For: "email"}) {
					@components.T(locales.LK_Email)
				}
				@input.Input(input.Props{
					ID:          "email",
					Name:        "email",
					Type:        "email",
					Value:       m.Email,
					Placeholder: "you@example.com",
					Required:    true,
					Attributes: templ.Attributes{
						"autocomplete": "email",
						"aria-invalid": len(emailValidations) > 0,
					},
				})
				@components.ValidationErrors(emailValidations)
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
				@components.T(locales.LK_ForgotPasswordPageSubmit)
			}
		</form>
		<p class="mt-6 text-sm">
			<a href={ g.RouteLogin } class="font-medium underline-offset-4 hover:underline">
				@components.T(locales.LK_LoginPageSignIn)
			</a>
		</p>
	}
}

templ ResetPassword(m models.ResetPassword) {
	{{
		passwordValidations := m.ValidatePassword()
		passwordMatchValidations := m.ValidatePasswordMatch()
	}}
	@authCard(utils.T(ctx, locales.LK_ResetPasswordPageTitle), "") {
		<form action={ g.RouteResetPassword } method="post" hx-boost="true" class="space-y-5">
			<input type="hidden" name="token" value={ m.Token }/>
			@field.Field() {
				@field.Label(field.LabelProps{For: "password"}) {
					@components.T(locales.LK_PasswordTitle)
				}
				@passwordInput(input.Props{
					ID:       "password",
					Name:     "password",
					Required: true,
					Attributes: templ.Attributes{
						"autocomplete": "new-password",
						"aria-invalid": len(passwordValidations) > 0,
					},
				})
				@components.ValidationErrors(passwordValidations)
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "password_2"}) {
					@components.T(locales.LK_PasswordConfirm)
				}
				@passwordInput(input.Props{
					ID:       "password_2",
					Name:     "password_2",
					Required: true,
					Attributes: templ.Attributes{
						"autocomplete": "new-password",
						"aria-invalid": len(passwordMatchValidations) > 0,
					},
				})
				@components.ValidationErrors(passwordMatchValidations)
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
				@components.T(locales.LK_ResetPasswordPageSubmit)
			}
		</form>
	}
}

// VerifyEmailBanner asks to confirm the email, nothing if already confirmed
templ VerifyEmailBanner(emailValidated bool) {
	if !emailValidated {
		<div role="status" class="flex flex-wrap items-center justify-between gap-2 rounded-md border bg-muted p-3 text-sm">
			<span>
				@components.T(locales.LK_VerifyEmailBanner)
			</span>
			<form action={ g.RouteVerifyEmailResend } method="post" hx-boost="true">
				@button.Button(button.Props{
					Type:    button.TypeSubmit,
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					@components.T(locales.LK_VerifyEmailResend)
				}
			</form>
		</div>
	}
}
