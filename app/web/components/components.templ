package components

import "roommates/internal/locales"
import "roommates/internal/utils"

// wraps component with html tag
//
//  <!DOCTYPE html>
//  <html>children...</html>
templ HtmlWrap() {
	{{ a := utils.GetAppearance(ctx) }}
	<!DOCTYPE html>
	<html lang={ utils.GetLocaleString(ctx) } data-theme={ a.Theme } data-mode={ a.Mode }>
		{ children... }
	</html>
}

// title has default which is i18n-zed
templ HeaderComponent(title string) {
	{{
		if title == "" {
			title = utils.T(ctx, locales.LK_AppTitle)
		}
	}}
	{{
		a := utils.GetAppearance(ctx)
		light, dark := a.Background()
	}}
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
		<title>{ title }</title>
		// the browser bar takes the page background
		switch a.Mode {
			case "light":
				<meta name="theme-color" content={ light }/>
			case "dark":
				<meta name="theme-color" content={ dark }/>
			default:
				<meta name="theme-color" media="(prefers-color-scheme: light)" content={ light }/>
				<meta name="theme-color" media="(prefers-color-scheme: dark)" content={ dark }/>
		}
		if a.Theme == "home" {
			<link rel="preload" href="/assets/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
		}
		<link rel="stylesheet" href="/assets/output.css"/>
		// installable app, see web/assets/pwa
		<link rel="manifest" href="/manifest.webmanifest"/>
		<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/>
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
		// by default htmx does not swap 4xx/5xx responses, which would leave
		// a submitted form without feedback, so error pages are swapped in too
		// allowEval is off as the CSP blocks eval anyway
		// https://htmx.org/docs/#response-handling
		<meta
			name="htmx-config"
			content={ `{"allowEval":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true},{"code":"...","swap":false}]}` }
		/>
		// https://htmx.org/docs/#installing
		<script src="/assets/lib/htmx.min.js"></script>
		// live updates, see appShell
		<script src="/assets/lib/sse.min.js"></script>
		<script src="/assets/local-time.js"></script>
		<script src="/assets/live-resync.js"></script>
		<script src="/assets/chat-hold.js"></script>
		<script src="/assets/chat-keyboard.js"></script>
		<script src="/assets/push.js"></script>
		<script src="/assets/copy.js"></script>
		<script src="/assets/reveal-password.js"></script>
		<script src="/assets/menus.js"></script>
		<script src="/assets/avatar-crop.js"></script>
		<script src="/assets/appearance-preview.js"></script>
		@Scripts()
	</head>
}

templ ValidationErrors(messages []locales.LKMessage) {
	if len(messages) > 0 {
		<div class="text-sm font-medium text-destructive " aria-live="polite">
			for _, msg := range messages {
				<li class="error">@T(msg.Key, msg.Args...)</li>
			}
		</div>
	}
}
